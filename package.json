{
  "name": "paper-craft",
  "version": "0.1.0",
  "description": "Agent-first research workflow CLI",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "eslint packages/",
    "format": "prettier --write 'packages/*/src/**/*.ts' 'tests/**/*.ts'",
    "format:check": "prettier --check 'packages/*/src/**/*.ts' 'tests/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && vitest run",
    "test:watch": "pnpm run build && vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.8.1",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@types/sql.js": "^1.4.11",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "commander": "^15.0.0",
    "sql.js": "^1.14.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5",
    "@modelcontextprotocol/client": "^2.4.0"
  },
  "private": true,
  "dependencies": {
    "@paper-craft/core": "workspace:*",
    "@paper-craft/cli": "workspace:*",
    "@paper-craft/mcp": "workspace:*"
  }
}
