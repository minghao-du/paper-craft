{
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "dist",
    "rootDir": ".",
    "types": [
      "node"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "customConditions": [
      "paper-craft-source"
    ]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "scripts/docs-*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests"
  ]
}
