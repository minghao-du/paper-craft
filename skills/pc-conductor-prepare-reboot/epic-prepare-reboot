#!/bin/sh
helper="$(dirname "$0")/../pc-conductor-recover/epic-recover"
case "${1-}" in
  --dry-run) shift; exec "$helper" status "$@" ;;
  '') exec "$helper" save ;;
  --help|-h) printf '%s\n' 'Usage: epic-prepare-reboot [--dry-run|--help]' 'Save the current tmux server; --dry-run only lists pane recovery identities.' ;;
  *) printf '%s\n' 'Use --help for supported options. This helper does not shut down the host or kill tmux.' >&2; exit 2 ;;
esac
